diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 41480a27c..e9edb4fe5 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -4730,12 +4730,16 @@ ggml_tensor * llm_graph_context::build_attn(
 
     // a mask per head, in the dense layout of the input mask, which flash attention takes in F16
     ggml_tensor * kq_mask = attn_mask.raw;
-    if (kq_mask->type != GGML_TYPE_F32) {
-        kq_mask = ggml_cast(ctx0, kq_mask, GGML_TYPE_F32);
-    }
-    kq_mask = ggml_add(ctx0, kq_b, kq_mask);
-    if (cparams.flash_attn) {
-        kq_mask = ggml_cast(ctx0, kq_mask, GGML_TYPE_F16);
+    if (cparams.flash_attn && kq_b->type == GGML_TYPE_F16 && kq_mask->type == GGML_TYPE_F16) {
+        kq_mask = ggml_add_inplace(ctx0, kq_b, kq_mask);
+    } else {
+        if (kq_mask->type != GGML_TYPE_F32) {
+            kq_mask = ggml_cast(ctx0, kq_mask, GGML_TYPE_F32);
+        }
+        kq_mask = ggml_add(ctx0, kq_b, kq_mask);
+        if (cparams.flash_attn) {
+            kq_mask = ggml_cast(ctx0, kq_mask, GGML_TYPE_F16);
+        }
     }
     cb(kq_mask, "kq_mask_rel_pos", il);
 
diff --git a/src/models/inkling2.cpp b/src/models/inkling2.cpp
index 29c552f9c..b7186dcbd 100644
--- a/src/models/inkling2.cpp
+++ b/src/models/inkling2.cpp
@@ -358,11 +358,21 @@ ggml_tensor * llama_model_inkling2::graph::build_layer(int il, int ip, ggml_tens
 
         // the sink logit t is per query: exp(s - t)/(1 + sum(exp(s - t))) = exp(s)/(exp(t) + sum(exp(s))), with a zero sink
         table = ggml_sub(ctx0, table, ggml_reshape_3d(ctx0, sinks, 1, n_head, n_tokens));
-        table = ggml_cont(ctx0, ggml_permute(ctx0, table, 1, 0, 2, 3));
-
-        ggml_tensor * kq_b = ggml_get_rows(ctx0, table, rel_pos);
-        kq_b = ggml_reshape_4d(ctx0, kq_b, n_head, n_kv, n_tokens/n_stream, n_stream);
-        kq_b = ggml_cont(ctx0, ggml_permute(ctx0, kq_b, 2, 0, 1, 3));
+        ggml_tensor * kq_b = nullptr;
+        if (cparams.flash_attn) {
+            table = ggml_cast(ctx0, ggml_permute(ctx0, table, 1, 0, 2, 3), GGML_TYPE_F16);
+            kq_b = ggml_new_tensor_4d(ctx0, GGML_TYPE_F16, table->ne[0], rel_pos->ne[0], rel_pos->ne[1], rel_pos->ne[2]);
+            kq_b->op = GGML_OP_GET_ROWS;
+            kq_b->src[0] = table;
+            kq_b->src[1] = rel_pos;
+            kq_b = ggml_reshape_4d(ctx0, kq_b, n_head, n_kv, n_tokens/n_stream, n_stream);
+            kq_b = ggml_cont(ctx0, ggml_permute(ctx0, kq_b, 2, 0, 1, 3));
+        } else {
+            table = ggml_cont(ctx0, ggml_permute(ctx0, table, 1, 0, 2, 3));
+            kq_b = ggml_get_rows(ctx0, table, rel_pos);
+            kq_b = ggml_reshape_4d(ctx0, kq_b, n_head, n_kv, n_tokens/n_stream, n_stream);
+            kq_b = ggml_cont(ctx0, ggml_permute(ctx0, kq_b, 2, 0, 1, 3));
+        }
         cb(kq_b, "kq_b", il);
 
         sinks = ggml_fill(ctx0, ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, n_head), 0.0f);
