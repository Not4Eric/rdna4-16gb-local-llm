# Required on Linux + 16 GB system RAM:
# - HSA_USERPTR_FOR_PAGED_MEM=0 avoids pageable-memory stalls under Linux RAM pressure.
# - FRANK_SERVER_*_PINNED=0 keeps prompt cache & context checkpoints pageable instead of pinning ~5.7 GiB RAM.
HSA_USERPTR_FOR_PAGED_MEM=0
FRANK_SERVER_CACHE_PINNED=0
FRANK_SERVER_CKPT_PINNED=0
