# Required on Linux + 16 GB system RAM + Inkling 2 Mini:
# - HSA_USERPTR_FOR_PAGED_MEM=0 avoids pageable-memory stalls under Linux RAM pressure.
# - FRANK_SERVER_*_PINNED=0 keeps prompt cache & checkpoints in pageable RAM.
# - LLAMA_SERVER_SPEC_CKPT_DEVICE=0 keeps variable-size SWA rollback checkpoints in host RAM
#   (prevents ggml_tallocr_alloc abort when n-gram rollbacks expand at 100k+ context).
HSA_USERPTR_FOR_PAGED_MEM=0
FRANK_SERVER_CACHE_PINNED=0
FRANK_SERVER_CKPT_PINNED=0
LLAMA_SERVER_SPEC_CKPT_DEVICE=0
